# Copy to .env.local. For local development, run `supabase start` and use the
# values it prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated OAuth buttons to show on the login page: google, github.
# Leave empty for email sign-in only. Each provider must be enabled in Supabase.
NEXT_PUBLIC_AUTH_PROVIDERS=

# Import from GitHub (optional). GitHub's anonymous rate limit is 60 requests
# an hour, about 20 imports for the whole server. With an OAuth app's id and
# secret it is 5,000. Use the app behind "Continue with GitHub" or any other;
# nobody has to create or rotate a token. Server only. Both or neither.
OAUTH_CLIENT_ID_GITHUB=
OAUTH_CLIENT_SECRET_GITHUB=

# Terms of Service and Privacy Policy (optional). The documents name whoever
# runs this server, so they only exist, at /terms and /privacy, when all three
# are set. Read both pages before you publish them under your name.
LEGAL_OPERATOR=
LEGAL_CONTACT=
LEGAL_GOVERNING_LAW=

# Email the app sends itself (optional): invitations, and abuse reports and
# new accounts to the operator. Without SMTP_HOST it sends none, and admins copy invite links
# by hand. These values send to the local stack's Mailpit, which shows every
# message at http://127.0.0.1:54324. Sign-in emails are Supabase Auth's own.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Subcanvas <hello@subcanvas.test>"
# Where abuse reports are emailed. Leave empty to use LEGAL_CONTACT.
ABUSE_EMAIL=
# Where the email about each new account, and the summary of each day, go.
# Leave empty to use LEGAL_CONTACT.
OPERATOR_EMAIL=
# The daily summary (optional): its route answers only a request carrying
# "Authorization: Bearer <CRON_SECRET>", and nobody while this is empty.
# Vercel's cron sends it by itself. Any long random string, for example from
# `openssl rand -hex 32`. Server only.
CRON_SECRET=

# Billing (optional). Self-hosted servers can leave all of this empty: there
# is then no paid plan, no Billing page, and no limits.
# The secret key from `supabase start` (never expose it to the browser):
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
# A recurring per-editor price, $5 a month, created in the Stripe dashboard:
STRIPE_PRICE_ID=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or from the webhook endpoint's page in the Stripe dashboard in production:
STRIPE_WEBHOOK_SECRET=
